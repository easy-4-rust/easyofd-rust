<!--
  Expected Page_0/Content.xml for simple_1.ofd
  Source: ofdrw/ofdrw conventions + GB/T 33190-2016

  Structure derived from:
  - ofdrw Page.java (content): Page root with Area, Content elements
  - GB/T 33190-2016 section 7.7: Page structure

  ofdrw behavior notes:
  - Page root element has xmlns:ofd namespace
  - Area element contains PhysicalBox for page dimensions
  - Content element contains Layer elements
  - Layer has Type attribute (e.g., "Body" for body content)
  - TextObject has ID, Boundary, Font, Size, TextCode children
  - TextCode has X, Y coordinates and text content
-->
<?xml version="1.0" encoding="UTF-8"?>
<ofd:Page xmlns:ofd="http://www.ofdspec.org/2016">
  <ofd:Area>
    <ofd:PhysicalBox>0 0 210 297</ofd:PhysicalBox>
  </ofd:Area>
  <ofd:Content>
    <ofd:Layer Type="Body">
      <ofd:TextObject ID="1" Boundary="10 10 190 20" Font="1" Size="12">
        <ofd:TextCode X="10" Y="20">Hello World</ofd:TextCode>
      </ofd:TextObject>
    </ofd:Layer>
  </ofd:Content>
</ofd:Page>
